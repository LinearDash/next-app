NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
# Application-owned TMDB API Read Access Token, server-only.
TMDB_ACCESS_TOKEN=
# Phase 5 AI (server-only; never prefix with NEXT_PUBLIC_). AI stays off unless all of these are set.
# Kill switch: anything other than 1 disables every Gemini request immediately.
GEMINI_ENABLED=0
# Comma-separated ISO country codes allowed to use AI (from Vercel's x-vercel-ip-country). Empty = nobody.
# "*" works only in local development (NODE_ENV != production). Choosing countries is a release/legal decision.
GEMINI_ALLOWED_COUNTRIES=
# Versioned AES-256-GCM keys; first encrypts, all decrypt. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use different values per environment. Losing them means users must re-enter their Gemini keys.
GEMINI_KEY_ENCRYPTION_KEYS=
